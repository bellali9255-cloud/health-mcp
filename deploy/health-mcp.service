[Unit]
Description=Self-hosted health data MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/health-mcp
EnvironmentFile=/etc/health-mcp.env
ExecStart=/usr/bin/node /opt/health-mcp/health-server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/health-mcp

[Install]
WantedBy=multi-user.target
