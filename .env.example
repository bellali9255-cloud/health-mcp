# 复制为 .env 后填写。两个 token 用随机值，且必须不一样：
#   openssl rand -hex 24

# 上传门锁：手机 App 上传时用，至少 16 字符（服务端强制）
HEALTH_INGEST_TOKEN=

# 读取门锁：AI 客户端读取时用。留空 = 任何人可读，强烈建议设一个
HEALTH_MCP_ACCESS_TOKEN=

# 数据落盘目录
HEALTH_DATA_DIR=/var/lib/health-mcp

# 对外域名，用于 Host 头校验，多个用逗号分隔
HEALTH_MCP_PUBLIC_URLS=https://health.example.com

# 监听端口与地址（只监听回环，公网由反代 / Tunnel 转进来）
HEALTH_MCP_PORT=3100
HEALTH_MCP_HOST=127.0.0.1

# 睡眠按「醒来日期」归属时使用的时区（默认 Asia/Shanghai）
HEALTH_TZ=Asia/Shanghai

# 上传 body 大小上限（默认 16mb）
# HEALTH_JSON_LIMIT=16mb
